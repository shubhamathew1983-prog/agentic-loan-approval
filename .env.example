# Anthropic API Configuration
ANTHROPIC_API_KEY=your_api_key_here

# Application Configuration
APP_ENV=development
DEBUG=True
APP_NAME="Agentic Loan Approval System"

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=True

# Streamlit Configuration
STREAMLIT_PORT=8501

# Storage Configuration
STORAGE_MODE=memory  # Options: memory, json
DATA_PERSISTENCE_FILE=data/application_data.json

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Model Configuration
LLM_MODEL=claude-haiku-4-5-20251001-v1:0
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1024
